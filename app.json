{
  "expo": {
    "name": "SessionTracker",
    "slug": "bolt-expo-nativewind",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/deepfried.jpg",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.workout"
    },
    "android": {
      "package": "com.yourname.workout",
      "versionCode": 5
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec11765d-5223-47a1-a20d-ac75c7317a24"
      }
    }
  }
}
